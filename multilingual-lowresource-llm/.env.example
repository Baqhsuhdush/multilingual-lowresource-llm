# ============================================
# МНОГОЯЗЫЧНАЯ LLM - КОНФИГУРАЦИЯ ОКРУЖЕНИЯ
# ============================================

# Безопасность и ключи API
# ============================================
HF_TOKEN=your_huggingface_token_here
WANDB_API_KEY=your_wandb_api_key_here
OPENAI_API_KEY=sk-your-openai-key-here  # Для вспомогательных задач

# Конфигурация модели
# ============================================
MODEL_NAME=Qwen/Qwen2.5-1.5B
MODEL_REVISION=main
MODEL_DEVICE=cuda  # cuda, cpu, mps
MODEL_CACHE_DIR=./models/cache

# Конфигурация тренировки
# ============================================
TRAIN_BATCH_SIZE=4
EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=2e-4
NUM_TRAIN_EPOCHS=3
WARMUP_STEPS=100
MAX_GRAD_NORM=1.0
LOGGING_STEPS=10
SAVE_STEPS=500
EVAL_STEPS=500

# Конфигурация RAG
# ============================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
FAISS_INDEX_TYPE=IndexFlatIP
BM25_K1=1.5
BM25_B=0.75
TOP_K_RETRIEVAL=5
TOP_K_RERANK=10
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# Конфигурация API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_LOG_LEVEL=info
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# Конфигурация базы данных/кэша
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
MAX_CACHE_SIZE=10000

# Конфигурация логирования
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/multilingual_llm.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_FORMAT=json

# Конфигурация мониторинга
# ============================================
PROMETHEUS_PORT=9090
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=multilingual_llm

# Конфигурация демо
# ============================================
DEMO_PORT=8501
DEMO_HOST=0.0.0.0
DEMO_THEME=light

# Конфигурация данных
# ============================================
DATA_CACHE_DIR=./data/cache
MAX_DOCUMENT_SIZE=1000000
SUPPORTED_LANGUAGES=["kk", "ru", "en"]
DEFAULT_LANGUAGE=kk

# Параметры производительности
# ============================================
TORCH_CUDA_ARCH_LIST="8.0;8.6;9.0"
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUM_WORKERS=2

# Отладка
# ============================================
DEBUG=false
VERBOSE=false
PROFILING=false